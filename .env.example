# ── Application ─────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_NAME="Clinical AI Orchestrator"
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# ── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=clinical_user
POSTGRES_PASSWORD=clinical_secret
POSTGRES_DB=clinical_triage
DATABASE_URL=postgresql+asyncpg://clinical_user:clinical_secret@localhost:5432/clinical_triage

# ── Cosmos DB / MongoDB ─────────────────────────────────────────
COSMOS_DB_CONNECTION_STRING=mongodb://localhost:27017
COSMOS_DB_NAME=clinical_reports

# ── Azure OpenAI ────────────────────────────────────────────────
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4

# ── Azure Cognitive Services — Computer Vision ──────────────────
AZURE_VISION_ENDPOINT=https://your-vision.cognitiveservices.azure.com/
AZURE_VISION_API_KEY=your-vision-api-key

# ── Azure Cognitive Search ──────────────────────────────────────
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_API_KEY=your-search-api-key
AZURE_SEARCH_INDEX_NAME=clinical-index

# ── Azure ML ────────────────────────────────────────────────────
AZURE_ML_SUBSCRIPTION_ID=your-subscription-id
AZURE_ML_RESOURCE_GROUP=your-resource-group
AZURE_ML_WORKSPACE_NAME=your-workspace

# ── Azure Identity (Key Vault) ──────────────────────────────────
AZURE_KEY_VAULT_URL=https://your-keyvault.vault.azure.net/

# ── Service Mode (mock | azure) ─────────────────────────────────
SERVICE_MODE=mock
